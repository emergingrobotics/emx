;;; gen-word-syntax.el --- generate emx word-motion tables from Emacs  -*- lexical-binding: t; -*-

;; Usage: emacs --batch -Q -l difftest/gen-word-syntax.el > crates/emx-core/src/command/word_syntax.rs
;;
;; Word motion (`forward-word') depends on the standard syntax table, on
;; `char-script-table', and on the character categories named in
;; `word-combining-categories' and `word-separating-categories'.  This dumps
;; them as sorted inclusive code-point ranges.

(defconst gen-word-syntax-max-char #x10FFFF)
(defconst gen-word-syntax-per-line 4)

(defun gen-word-syntax--ranges (value-of)
  "Runs of code points with the same non-nil VALUE-OF, as (START END VALUE)."
  (let ((ranges nil) (start nil) (current nil) (code 0))
    (while (<= code (1+ gen-word-syntax-max-char))
      (let ((value (and (<= code gen-word-syntax-max-char)
                        (not (and (>= code #xD800) (<= code #xDFFF)))
                        (funcall value-of code))))
        (unless (equal value current)
          (when current (push (list start (1- code) current) ranges))
          (setq start code current value)))
      (setq code (1+ code)))
    (nreverse ranges)))

(defun gen-word-syntax--emit (name doc ranges with-value)
  (princ (format "\n/// %s\n#[rustfmt::skip]\npub(super) const %s: &[%s] = &[\n"
                 doc name (if with-value "(u32, u32, u16)" "(u32, u32)")))
  (let ((count 0))
    (dolist (range ranges)
      (when (zerop (% count gen-word-syntax-per-line)) (princ "   "))
      (princ (if with-value
                 (format " (0x%X, 0x%X, %d)," (nth 0 range) (nth 1 range) (nth 2 range))
               (format " (0x%X, 0x%X)," (nth 0 range) (nth 1 range))))
      (setq count (1+ count))
      (when (zerop (% count gen-word-syntax-per-line)) (princ "\n"))))
  (unless (zerop (% (length ranges) gen-word-syntax-per-line)) (princ "\n"))
  (princ "];\n"))

(with-temp-buffer
  (fundamental-mode)
  (let ((scripts nil))
    (princ (format "//! Generated by `difftest/gen-word-syntax.el` from GNU Emacs %s; do not edit.\n"
                   emacs-version))
    (princ "//! Inclusive code-point ranges, sorted and disjoint.\n")
    (gen-word-syntax--emit
     "WORD" "Word constituents in `standard-syntax-table`."
     (gen-word-syntax--ranges (lambda (code) (eq (char-syntax code) ?w))) nil)
    (gen-word-syntax--emit
     "SCRIPTS" "`char-script-table`: each run's script, numbered in order of first appearance."
     (gen-word-syntax--ranges
      (lambda (code)
        (let ((script (aref char-script-table code)))
          (when script
            (unless (memq script scripts) (setq scripts (append scripts (list script))))
            (1+ (seq-position scripts script))))))
     t)
    (dolist (category '((?^ "COMBINING_DIACRITIC" "Category `^`: combining diacritic or mark.")
                        (?C "CHINESE" "Category `C`: Chinese (Han) characters.")
                        (?H "HIRAGANA" "Category `H`: Japanese Hiragana.")
                        (?K "KATAKANA" "Category `K`: Japanese Katakana.")))
      (gen-word-syntax--emit
       (nth 1 category) (nth 2 category)
       (gen-word-syntax--ranges
        (lambda (code) (aref (char-category-set code) (car category))))
       nil))))

;;; gen-word-syntax.el ends here
